# gradlew 必须在任何平台都是 LF，否则 Linux/macOS 上会报 "bad interpreter"
gradlew            text eol=lf
*.sh               text eol=lf
*.bat              text eol=crlf

# 文本文件统一 LF，避免 Windows 提交进来后满篇 diff
*.java             text eol=lf
*.gradle           text eol=lf
*.json             text eol=lf
*.md               text eol=lf
*.properties       text eol=lf

# 二进制，别让 git 试图合并
*.png              binary
*.jar              binary
